# Variables d'environnement — copier vers `.env` et adapter.
# Ne jamais commiter de vrai secret ici.

# Port du serveur (défaut : 3000)
PORT=3000

# Connexion Postgres locale (défaut si absent :
# postgres://soukly:soukly-dev-only@localhost:5432/soukly)
# Le mot de passe `soukly-dev-only` est un mot de passe de développement
# local uniquement — à changer en production.
DATABASE_URL=postgres://soukly:soukly-dev-only@localhost:5432/soukly

# Secret de signature des jetons JWT — OBLIGATOIRE en production,
# une longue chaîne aléatoire. En dev, un secret par défaut est utilisé
# (avec un avertissement au démarrage).
# JWT_SECRET=<longue-chaine-aleatoire>

# Jeton admin — exigé (Bearer) sur toutes les routes /api/admin/*.
# OBLIGATOIRE : sans lui, les routes admin répondent 503.
# Générer une longue chaîne aléatoire, par exemple :
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ADMIN_TOKEN=<longue-chaine-aleatoire>

# Connexion Google (connexion native + test de configuration).
# L'identifiant et le secret peuvent aussi être enregistrés via
# POST /api/admin/google-settings (ils priment sur ces variables).
# Ne jamais créer d'identifiant ici : copier ceux du projet Google Cloud.
# GOOGLE_CLIENT_ID=<id-client>.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-...

# Connexion Apple (iOS) — identifiant du paquet de l'appli (audience du
# jeton d'identité), par exemple com.soukly.app. Aucun secret nécessaire
# côté serveur (vérification par la clé publique Apple).
# APPLE_CLIENT_ID=com.soukly.app
